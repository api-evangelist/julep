{
  "opencollection": "1.0.0",
  "info": {
    "name": "Julep Agents Embed API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Embed",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "EmbedRoute_embed",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{serverEnv}.julep.ai/api/embed",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Embed a query for search"
        }
      ]
    }
  ],
  "bundled": true
}