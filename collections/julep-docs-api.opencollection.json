{
  "opencollection": "1.0.0",
  "info": {
    "name": "Julep Agents Docs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Docs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "IndividualDocsRoute_get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{serverEnv}.julep.ai/api/docs/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource"
              },
              {
                "name": "include_embeddings",
                "value": "",
                "type": "query",
                "description": "Whether to include embeddings in the response"
              }
            ]
          },
          "docs": "Get Doc by id"
        }
      ]
    }
  ],
  "bundled": true
}