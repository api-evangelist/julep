{
  "opencollection": "1.0.0",
  "info": {
    "name": "Julep Agents Sessions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SessionsRoute_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{serverEnv}.julep.ai/api/sessions",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of items returned"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset the items returned"
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "Sort by a field"
              },
              {
                "name": "direction",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              },
              {
                "name": "metadata_filter",
                "value": "",
                "type": "query",
                "description": "Object to filter results by metadata"
              }
            ]
          },
          "docs": "List sessions (paginated)"
        },
        {
          "info": {
            "name": "SessionsRoute_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{serverEnv}.julep.ai/api/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new session"
        },
        {
          "info": {
            "name": "SessionsRoute_get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource"
              }
            ]
          },
          "docs": "Get a session by id"
        },
        {
          "info": {
            "name": "SessionsRoute_createOrUpdate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update a session"
        },
        {
          "info": {
            "name": "SessionsRoute_update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing session by its id (overwrites all existing values)"
        },
        {
          "info": {
            "name": "SessionsRoute_patch",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing session by its id (merges with existing values)"
        },
        {
          "info": {
            "name": "SessionsRoute_delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource"
              }
            ]
          },
          "docs": "Delete a session by its id"
        },
        {
          "info": {
            "name": "ChatRoute_generate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id/chat",
            "headers": [
              {
                "name": "x-custom-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The session ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate a response from the model"
        },
        {
          "info": {
            "name": "HistoryRoute_history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id/history",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of parent"
              }
            ]
          },
          "docs": "Get history of a Session"
        },
        {
          "info": {
            "name": "HistoryRoute_delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id/history",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the resource"
              }
            ]
          },
          "docs": "Clear the history of a Session (resets the Session)"
        },
        {
          "info": {
            "name": "RenderRoute_render",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{serverEnv}.julep.ai/api/sessions/:id/render",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The session ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Render system prompt for the session"
        }
      ]
    }
  ],
  "bundled": true
}